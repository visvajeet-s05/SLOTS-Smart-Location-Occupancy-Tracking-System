generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model booking {
  id                            String          @id @default(cuid())
  customerId                    String
  ownerId                       String
  parkingLotId                  String
  status                        booking_status? @default(PENDING_PAYMENT)
  createdAt                     DateTime        @default(now())
  amount                        Float
  endTime                       DateTime
  startTime                     DateTime
  vehicleType                   String
  vehicleNumber                 String?
  lockExpiresAt                 DateTime?
  updatedAt                     DateTime        @default(now()) @updatedAt
  slotId                        String?
  parkingBayId                  String?
  actualCheckIn                 DateTime?
  actualCheckOut                DateTime?
  allocatedSlotId               String?
  fineAmount                    Float           @default(0)
  idempotencyKey                String?         @unique
  lotConfigSnapshot             String?
  occupancyState                OccupancyState  @default(NOT_OCCUPIED)
  originalSlotId                String?
  overstayAmount                Float           @default(0)
  paymentStatus                 payment_status  @default(PENDING)
  refundAmount                  Float           @default(0)
  temporaryReassignmentReason   String?
  user_booking_customerIdTouser user            @relation("booking_customerIdTouser", fields: [customerId], references: [id])
  user_booking_ownerIdTouser    user            @relation("booking_ownerIdTouser", fields: [ownerId], references: [id])
  parkingBay                    parkingbay?     @relation(fields: [parkingBayId], references: [id])
  parkinglot                    parkinglot      @relation(fields: [parkingLotId], references: [id])
  slot                          slot?           @relation(fields: [slotId], references: [id])

  @@index([customerId])
  @@index([slotId])
  @@index([originalSlotId])
  @@index([allocatedSlotId])
  @@index([parkingBayId])
  @@index([ownerId])
  @@index([parkingLotId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([lockExpiresAt])
  @@index([idempotencyKey])
  @@index([slotId, status, startTime, endTime])
}

model demandprediction {
  id          String   @id
  parkingId   String
  hour        Int
  date        DateTime
  demandScore Float
  createdAt   DateTime @default(now())
}

model event {
  id          String      @id
  name        String
  venue       String
  eventType   String
  startTime   DateTime
  endTime     DateTime
  impactScore Float       @default(1)
  lotId       String?
  lat         Float?
  lng         Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  parkinglot  parkinglot? @relation(fields: [lotId], references: [id])

  @@index([endTime])
  @@index([eventType])
  @@index([lotId])
  @@index([startTime])
}

model exchangerate {
  id          String   @id
  currency    String   @unique
  rateToUSD   Float
  lastUpdated DateTime
  createdAt   DateTime @default(now())

  @@index([currency])
}

model maintenanceschedule {
  id         String   @id
  ownerId    String
  parkingLot String
  startDate  DateTime
  endDate    DateTime
  reason     String
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownerincident {
  id           String               @id
  ownerId      String
  title        String
  description  String
  status       ownerincident_status @default(OPEN)
  createdAt    DateTime             @default(now())
  resolvedAt   DateTime?
  ownerprofile ownerprofile         @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownerinvoice {
  id           String       @id
  ownerId      String
  month        Int
  grossAmount  Float
  taxAmount    Float
  generatedAt  DateTime     @default(now())
  netAmount    Float
  pdfUrl       String?
  platformFee  Float
  year         Int
  ownerprofile ownerprofile @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownermaintenance {
  id           String       @id
  ownerId      String
  startTime    DateTime
  endTime      DateTime
  reason       String
  createdAt    DateTime     @default(now())
  ownerprofile ownerprofile @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownerprofile {
  id                   String                @id
  userId               String                @unique
  businessName         String
  phone                String
  status               ownerprofile_status   @default(OWNER_ONBOARDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  address              String?
  ownerincident        ownerincident[]
  ownerinvoice         ownerinvoice[]
  ownermaintenance     ownermaintenance[]
  user                 user                  @relation(fields: [userId], references: [id])
  ownersettlement      ownersettlement[]
  ownerstaff           ownerstaff[]
  ownersupportticket   ownersupportticket[]
  ownerverification    ownerverification?
  parkinglot           parkinglot[]
  parkingsetupprogress parkingsetupprogress?
}

model ownersettlement {
  id           String       @id
  ownerId      String
  amount       Float
  referenceId  String
  settledAt    DateTime
  ownerprofile ownerprofile @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownerstaff {
  id           String          @id
  ownerId      String
  name         String
  email        String
  role         ownerstaff_role
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  ownerprofile ownerprofile    @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownersupportticket {
  id           String                    @id
  ownerId      String
  subject      String
  message      String
  status       ownersupportticket_status @default(OPEN)
  createdAt    DateTime                  @default(now())
  ownerprofile ownerprofile              @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model ownerverification {
  id              String       @id
  ownerId         String       @unique
  documentType    String
  documentUrl     String
  submittedAt     DateTime     @default(now())
  reviewedByAdmin String?
  reviewedAt      DateTime?
  rejectionReason String?
  ownerprofile    ownerprofile @relation(fields: [ownerId], references: [id])
}

model parkingincident {
  id          String                 @id
  ownerId     String
  bookingId   String?
  description String
  status      parkingincident_status @default(OPEN)
  createdAt   DateTime               @default(now())
  user        user                   @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model parkinglot {
  id            String            @id
  ownerId       String
  name          String
  address       String
  lat           Float
  lng           Float
  status        parkinglot_status @default(DRAFT)
  cameraUrl     String?
  totalSlots    Int               @default(120)
  edgeNodeId    String?           @unique
  edgeToken     String?           @unique
  lastHeartbeat DateTime?
  ddnsDomain    String?
  parkingSiteId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime
  timezone      String            @default("Asia/Kolkata")
  booking       booking[]
  camera        camera[]
  event         event[]
  mediafile     mediafile[]
  parkinglevel  parkinglevel[]
  ownerprofile  ownerprofile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parkingSite   parkingsite?      @relation(fields: [parkingSiteId], references: [id])
  parkingslot   parkingslot[]
  priceaudit    priceaudit[]
  pricingrule   pricingrule[]
  slot          slot[]

  @@index([ownerId])
  @@index([parkingSiteId])
}

model parkingsetupprogress {
  id            String       @id
  ownerId       String       @unique
  locationDone  Boolean      @default(false)
  slotsDone     Boolean      @default(false)
  pricingDone   Boolean      @default(false)
  amenitiesDone Boolean      @default(false)
  submitted     Boolean      @default(false)
  lastStep      String?
  ownerprofile  ownerprofile @relation(fields: [ownerId], references: [id])
}

model parkingslot {
  id           String           @id
  parkingLotId String
  slotNumber   String
  type         parkingslot_type
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  parkinglot   parkinglot       @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  @@index([parkingLotId])
}

model payment {
  id                      String         @id @default(cuid())
  bookingId               String?
  userId                  String?
  stripeId                String?
  amount                  Float
  currency                String         @default("USD")
  paymentMethod           PaymentMethod  @default(STRIPE_CARD)
  status                  payment_status @default(PENDING)
  region                  String?
  cryptoToken             String?
  cryptoChain             String?
  cryptoWallet            String?
  txHash                  String?
  stripePaymentIntentId   String?        @unique
  stripeCheckoutSessionId String?
  fromAddress             String?
  confirmedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([stripeId])
  @@index([status])
  @@index([txHash])
  @@index([stripePaymentIntentId])
}

model priceaudit {
  id           String     @id
  parkingLotId String
  oldPrice     Float
  newPrice     Float
  reason       String
  triggeredBy  String?
  eventId      String?
  createdAt    DateTime   @default(now())
  parkinglot   parkinglot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([parkingLotId])
}

model pricingrule {
  id           String     @id
  parkingLotId String
  basePrice    Float
  hourlyRate   Float
  dynamic      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  currentPrice Float?
  lastUpdated  DateTime?
  parkinglot   parkinglot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  @@index([parkingLotId])
}

model refund {
  id        String   @id
  paymentId String   @unique
  amount    Float
  txHash    String?
  reason    String
  createdAt DateTime @default(now())
}

model review {
  id        String   @id
  bookingId String
  rating    Int
  comment   String
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model subscription {
  id                   String           @id @default(cuid())
  userId               String
  stripeSubscriptionId String?
  tier                 SubscriptionTier @default(NONE)
  siteId               String?
  startDate            DateTime         @default(now())
  endDate              DateTime
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([siteId])
  @@index([stripeSubscriptionId])
}

model user {
  id                               String                @id @default(cuid())
  name                             String?
  email                            String                @unique
  passwordHash                     String?
  password                         String?
  role                             user_role             @default(CUSTOMER)
  phone                            String?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime?
  lastLoginAt                      DateTime?
  preferredCurrency                String                @default("INR")
  walletBalance                    Float                 @default(0)
  booking_booking_customerIdTouser booking[]             @relation("booking_customerIdTouser")
  booking_booking_ownerIdTouser    booking[]             @relation("booking_ownerIdTouser")
  fastag                           fastag[]
  fastagaccount                    fastagaccount[]
  maintenanceschedule              maintenanceschedule[]
  ownerprofile                     ownerprofile?
  parkingincident                  parkingincident[]
  session                          session[]
  subscription                     subscription[]
  vehicle                          vehicle[]
}

model vehicle {
  id           String   @id
  userId       String
  licensePlate String
  make         String
  model        String
  color        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  fastag       fastag?
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ComplianceViolation {
  id              String        @id @default(cuid())
  type            String
  slotId          String
  vehiclePlate    String
  severity        String
  status          String        @default("ACTIVE")
  durationMinutes Int           @default(0)
  lotId           String
  levelId         String?
  timestamp       DateTime      @default(now())
  resolvedAt      DateTime?
  parkingLevel    parkinglevel? @relation(fields: [levelId], references: [id], onDelete: Cascade)
  slot            slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([status])
  @@index([timestamp])
  @@index([levelId])
  @@index([slotId])
  @@map("compliance_violations")
}

model LandownerSubmission {
  id                     String    @id @default(cuid())
  ownerName              String
  ownerEmail             String
  ownerPhone             String
  ownershipProofDocument String?
  lengthMeters           Float
  widthMeters            Float
  areaSqMeters           Float
  entryLanes             Int
  exitLanes              Int
  isMultiStorey          Boolean
  floors                 Int
  surfaceType            String
  gpsLat                 Float
  gpsLng                 Float
  plotAddress            String?
  avgHourlyRateINR       Float
  surveyResult           String
  status                 String    @default("PENDING_REVIEW")
  submittedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?
  notes                  String?

  @@index([ownerEmail])
  @@index([status])
  @@index([submittedAt])
  @@map("landowner_submissions")
}

model passwordresettoken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model auditlog {
  id             String   @id @default(cuid())
  actorId        String
  actorRole      String
  action         String
  targetResource String
  ipAddress      String
  metadataJson   String
  timestamp      DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([actorRole])
  @@index([timestamp])
}

model camera {
  id                  String              @id
  lotId               String
  name                String
  url                 String?
  levelId             String?
  zones               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  calibrationAccuracy Float?
  calibrationMatrix   String?
  cameraType          String              @default("IP_CAMERA")
  coverageRadius      Float?
  isActive            Boolean             @default(true)
  lastCalibratedAt    DateTime?
  positionX           Float?
  positionY           Float?
  parkinglevel        parkinglevel?       @relation(fields: [levelId], references: [id])
  parkinglot          parkinglot          @relation(fields: [lotId], references: [id])
  camerazonemapping   camerazonemapping[]
  slot                slot[]

  @@index([levelId])
  @@index([lotId])
}

model camerazonemapping {
  id        String   @id
  cameraId  String
  zoneCode  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  camera    camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@unique([cameraId, zoneCode])
  @@index([cameraId])
  @@index([zoneCode])
}

model compliancealert {
  id                  String    @id
  type                String
  lotId               String
  slotId              String
  vehiclePlateNumber  String?
  expectedPlateNumber String?
  severity            String
  status              String    @default("ACTIVE")
  metadata            String
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?
  resolvedBy          String?

  @@index([createdAt])
  @@index([lotId])
  @@index([severity])
  @@index([slotId])
  @@index([status])
  @@index([type])
}

model demandsnapshot {
  id                 String              @id
  siteId             String
  occupancyRate      Float
  calculatedRate     Float
  demandScore        Float
  weatherCondition   String?
  isPeakHour         Boolean             @default(false)
  timestamp          DateTime            @default(now())
  pricingRuleId      String?
  dynamicpricingrule dynamicpricingrule? @relation(fields: [pricingRuleId], references: [id])
  parkingsite        parkingsite         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([isPeakHour])
  @@index([pricingRuleId])
  @@index([siteId])
  @@index([timestamp])
}

model dynamicpricingrule {
  id                  String           @id
  siteId              String
  baseRatePerHour     Float
  minRate             Float
  maxRate             Float
  occupancyMultiplier Float            @default(1)
  peakMultiplier      Float            @default(1)
  eventMultiplier     Float            @default(1)
  isDynamicEnabled    Boolean          @default(true)
  updatedAt           DateTime
  createdAt           DateTime         @default(now())
  demandsnapshot      demandsnapshot[]
  parkingsite         parkingsite      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([isDynamicEnabled])
  @@index([siteId])
}

model edgedevice {
  id              String            @id
  siteId          String
  deviceName      String
  ipAddress       String
  status          edgedevice_status @default(OFFLINE)
  firmwareVersion String?
  lastHeartbeat   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  parkingsite     parkingsite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([ipAddress])
  @@index([siteId])
  @@index([status])
}

model edgedevicesecret {
  id                String   @id
  deviceId          String   @unique
  secretKey         String
  previousSecretKey String?
  rotationTimestamp DateTime @default(now())
  gracePeriodEndsAt DateTime
  isActive          Boolean  @default(true)

  @@index([deviceId])
  @@index([gracePeriodEndsAt])
  @@index([isActive])
}

model evsession {
  id                String           @id
  slotId            String
  status            evsession_status @default(ACTIVE)
  energyConsumedKwh Float            @default(0)
  powerKw           Float            @default(7.2)
  costPerKwh        Float            @default(15)
  startTime         DateTime         @default(now())
  endTime           DateTime?
  slot              slot             @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([startTime])
  @@index([status])
}

model fastag {
  id        String        @id
  tagId     String        @unique
  walletId  String?
  vehicleId String        @unique
  userId    String
  balance   Float         @default(0)
  status    fastag_status @default(ACTIVE)
  issuedAt  DateTime      @default(now())
  user      user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
}

model fastagaccount {
  id            String   @id
  userId        String
  tagId         String   @unique
  vehicleNumber String   @unique
  walletBalance Float    @default(1000)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([tagId])
  @@index([userId])
  @@index([vehicleNumber])
}

model floor {
  id          String      @id
  siteId      String
  levelName   String
  levelNumber Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  parkingsite parkingsite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zone        zone[]

  @@index([levelNumber])
  @@index([siteId])
}

model hardwaredevice {
  id            String                    @id
  siteId        String
  name          String
  deviceType    hardwaredevice_deviceType
  ipAddress     String?
  macAddress    String?                   @unique
  status        hardwaredevice_status     @default(ONLINE)
  lastHeartbeat DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  parkingsite   parkingsite               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([deviceType])
  @@index([lastHeartbeat])
  @@index([siteId])
  @@index([status])
}

model idempotencykeys {
  id             String   @id
  actionType     String
  idempotencyKey String
  userId         String
  result         String
  processedAt    DateTime @default(now())
  expiresAt      DateTime

  @@unique([actionType, idempotencyKey])
  @@index([expiresAt])
  @@index([userId])
}

model lotconfig {
  lotId                          String   @unique
  advanceBookingHours            Int      @default(12)
  minBookingLeadMinutes          Int      @default(15)
  checkinGraceDivisor            Int      @default(6)
  minCheckinGraceMinutes         Int      @default(5)
  maxCheckinGraceMinutes         Int      @default(30)
  refundUsageThreshold           Int      @default(80)
  minRefundAmount                Float    @default(10)
  paymentHoldMinutes             Int      @default(5)
  minBookingDurationMinutes      Int      @default(30)
  maxBookingDurationMinutes      Int      @default(720)
  noShowFine                     Float    @default(50)
  overstayBlockMinutes           Int      @default(30)
  overstayRatePerBlock           Float    @default(30)
  overstayMaxChargeMultiple      Int      @default(4)
  overstayMinMaxCharge           Float    @default(200)
  turnoverBufferMinutes          Int      @default(5)
  noCompatibleSlotGraceMinutes   Int      @default(15)
  cancellationPolicy             String
  upcomingBookingReminderMinutes Int      @default(30)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime

  @@index([lotId])
}

model mediafile {
  id                  String     @id
  lotId               String
  slotId              String?
  type                String
  filePath            String
  fileSize            Int        @default(0)
  createdAt           DateTime   @default(now())
  isViolationEvidence Boolean    @default(false)
  metadata            String
  parkinglot          parkinglot @relation(fields: [lotId], references: [id])

  @@index([createdAt])
  @@index([isViolationEvidence])
  @@index([lotId])
  @@index([type])
}

model occupancylog {
  id              String                   @id
  bayId           String
  vehicleType     occupancylog_vehicleType
  plateNumber     String
  entryTime       DateTime                 @default(now())
  exitTime        DateTime?
  confidenceScore Float
  createdAt       DateTime                 @default(now())
  parkingbay      parkingbay               @relation(fields: [bayId], references: [id], onDelete: Cascade)

  @@index([bayId])
  @@index([entryTime])
  @@index([plateNumber])
}

model parkingbay {
  id           String                 @id
  zoneId       String
  bayNumber    String
  vehicleType  parkingbay_vehicleType @default(CAR)
  status       parkingbay_status      @default(AVAILABLE)
  currentPlate String?
  lastUpdated  DateTime               @default(now())
  createdAt    DateTime               @default(now())
  bayType      parkingbay_bayType     @default(STANDARD)
  isAccessible Boolean                @default(false)
  isReserved   Boolean                @default(false)
  bookings     booking[]
  occupancylog occupancylog[]
  zone         zone                   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, bayNumber])
  @@index([bayNumber])
  @@index([bayType])
  @@index([isAccessible])
  @@index([status])
  @@index([zoneId])
}

model parkinglevel {
  id                   String                @id
  parkingLotId         String
  levelName            String
  floorNumber          Int
  totalSlots           Int                   @default(0)
  cameraCount          Int                   @default(0)
  mapSvgUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  camera               camera[]
  complianceViolations ComplianceViolation[]
  parkinglot           parkinglot            @relation(fields: [parkingLotId], references: [id])
  slot                 slot[]

  @@index([floorNumber])
  @@index([parkingLotId])
}

model parkingsite {
  id                 String               @id
  name               String
  location           String
  latitude           Float
  longitude          Float
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  demandsnapshot     demandsnapshot[]
  dynamicpricingrule dynamicpricingrule[]
  edgedevice         edgedevice[]
  floor              floor[]
  hardwaredevice     hardwaredevice[]
  parkingLots        parkinglot[]

  @@index([latitude, longitude])
}

model processedwebhookevents {
  id          String   @id
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
  metadata    String

  @@index([eventId])
  @@index([eventType])
  @@index([processedAt])
}

model session {
  id           String   @id
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
  @@index([sessionToken])
  @@index([userId])
}

model slot {
  id                   String                @id
  lotId                String
  cameraId             String?
  levelId              String?
  zoneCode             String?
  aisleNumber          Int?
  positionX            Float?
  positionY            Float?
  slotNumber           Int
  row                  String
  x                    Int?
  y                    Int?
  width                Int?
  height               Int?
  status               slot_status?          @default(AVAILABLE)
  aiConfidence         Float                 @default(100)
  updatedBy            slot_updatedBy        @default(AI)
  updatedAt            DateTime
  price                Float                 @default(50)
  slotType             String                @default("REGULAR")
  displayName          String?
  bookings             booking[]
  complianceViolations ComplianceViolation[]
  evsession            evsession[]
  camera               camera?               @relation(fields: [cameraId], references: [id])
  parkinglevel         parkinglevel?         @relation(fields: [levelId], references: [id])
  parkinglot           parkinglot            @relation(fields: [lotId], references: [id])

  @@unique([lotId, slotNumber])
  @@index([cameraId])
  @@index([levelId])
  @@index([lotId])
  @@index([status])
  @@index([zoneCode])
}

model slotallocationhistory {
  id             String    @id
  bookingId      String
  slotId         String
  allocationType String
  assignedAt     DateTime  @default(now())
  releasedAt     DateTime?
  reason         String?

  @@index([assignedAt])
  @@index([bookingId])
  @@index([releasedAt])
  @@index([slotId])
}

model slotstatuslog {
  id           String                  @id
  slotId       String
  oldStatus    slotstatuslog_oldStatus
  newStatus    slotstatuslog_newStatus
  updatedBy    slotstatuslog_updatedBy
  aiConfidence Float                   @default(100)
  createdAt    DateTime                @default(now())

  @@index([createdAt])
  @@index([slotId])
}

model systemalert {
  id        String   @id
  type      String
  severity  String
  message   String
  source    String
  siteId    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([siteId])
  @@index([status])
  @@index([type])
}

model zone {
  id         String       @id
  floorId    String
  zoneName   String
  capacity   Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  parkingbay parkingbay[]
  floor      floor        @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([floorId])
}

