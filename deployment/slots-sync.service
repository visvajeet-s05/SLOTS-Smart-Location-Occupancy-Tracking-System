[Unit]
Description=SLOTS Edge SQLite to MQTT Sync Daemon
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/slots
Environment="PATH=/home/pi/.local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/pi/slots/edge/sync_daemon.py \
  --mqtt-broker central.slotify.in \
  --mqtt-port 1883 \
  --site-id CHENNAI-PILOT-01 \
  --sync-interval 5
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=slots-sync

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/pi/slots

[Install]
WantedBy=multi-user.target