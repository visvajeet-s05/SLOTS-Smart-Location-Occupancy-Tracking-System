# SLOTS Docker Environment Configuration
# Copy this file to .env and adjust values for your environment

# ──────────────────────────────────────────────────────────────────────────────
#   IP Webcam Stream Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Your smartphone's IP Webcam MJPEG stream URL
IP_WEBCAM_URL=http://100.125.245.26:8080/video

# Alternative RTSP stream (H.264) for TensorRT acceleration
# IP_WEBCAM_RTSP=rtsp://100.125.245.26:8080/h264_pcm.sdp

# Single snapshot endpoint (fallback if MJPEG drops frames)
# IP_WEBCAM_SNAPSHOT=http://100.125.245.26:8080/shot.jpg

# ──────────────────────────────────────────────────────────────────────────────
#   Redis Configuration
# ──────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────────────────────────────────────
#   Service Ports
# ──────────────────────────────────────────────────────────────────────────────
PRICING_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002
REALTIME_SERVICE_PORT=3000
EV_CHARGING_SERVICE_PORT=8003
V2X_SERVICE_PORT=8004

# ──────────────────────────────────────────────────────────────────────────────
#   Edge Vision Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Enable threaded stream reader for zero-latency
USE_THREADED_STREAM=True

# ANPR Engine Configuration
ANPR_CONFIDENCE_THRESHOLD=0.5
ANPR_USE_GPU=False

# Two-Wheeler Tracker Configuration
TRACKER_MAX_CAPACITY_PER_ZONE=5
TRACKER_MIN_DENSITY_THRESHOLD=0.15

# Session Tracking Configuration
GRACE_PERIOD_SECONDS=300
PLATE_TIMEOUT_SECONDS=10

# Parking Zone Polygon (adjust based on camera view)
# Format: x1,y1;x2,y2;x3,y3;x4,y4
ZONE_POLYGON=400,300;800,300;800,600;400,600

# ──────────────────────────────────────────────────────────────────────────────
#   NPCI FASTag Configuration
# ──────────────────────────────────────────────────────────────────────────────
# NPCI FASTag API credentials
NPCI_API_KEY=your_npci_api_key_here
NPCI_API_SECRET=your_npci_api_secret_here
NPCI_API_URL=https://api.npci.org/fastag/v1

# FASTag merchant ID
FASTAG_MERCHANT_ID=your_merchant_id_here

# ──────────────────────────────────────────────────────────────────────────────
#   WhatsApp Notification Configuration
# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Business API credentials
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# WhatsApp API URL
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# UPI Deep Link Configuration
UPI_VPA=your_vpa@upi
UPI_MERCHANT_CODE=your_merchant_code
UPI_TRANSACTION_NOTE=SLOTS Parking Payment

# ──────────────────────────────────────────────────────────────────────────────
#   MARL Pricing Engine Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Pricing guardrails
PRICING_MIN_PRICE=20.0
PRICING_MAX_PRICE=150.0
PRICING_MAX_STEP_CHANGE_PCT=0.15
PRICING_TARGET_OCCUPANCY=0.85

# MARL Agent Configuration
MARL_USE_SB3=True
MARL_MODEL_PATH=./models/marl_pricing_model.zip

# ──────────────────────────────────────────────────────────────────────────────
#   OCPP 2.0.1 EV Charging Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Charging tariff configuration
BASE_CHARGING_RATE=8.0
BASE_PARKING_RATE=5.0
OVERSTAY_PENALTY_RATE=5.0
OVERSTAY_GRACE_PERIOD_MINUTES=15
GRID_LOAD_FACTOR_DEFAULT=1.0

# OCPP WebSocket configuration
OCPP_PROTOCOL_VERSION=2.0.1
OCPP_WEBSOCKET_PORT=8003

# ──────────────────────────────────────────────────────────────────────────────
#   ISO 23374 V2X Wayfinding Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Parking layout configuration
SLOTS_LAYOUT_CONFIG=config/slots_calibration.json

# Trajectory configuration
TRAJECTORY_UPDATE_HZ=10
MAX_VELOCITY_DEFAULT=5.0
GRID_RESOLUTION=0.5

# V2X MQTT configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_V2X_NAV=slots/v2x/navigation

# ──────────────────────────────────────────────────────────────────────────────
#   Logging & Monitoring
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# Enable debug mode (additional logging)
DEBUG=False

# ──────────────────────────────────────────────────────────────────────────────
#   Production Settings
# ──────────────────────────────────────────────────────────────────────────────
# Environment (development, staging, production)
ENVIRONMENT=development

# Enable CORS for API services
ENABLE_CORS=True

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:8002
