# SLOTS Edge Vision Service Dockerfile
# Optimized for OpenCV, PaddleOCR, and ONNX Runtime inference

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENCV_BUILD_DIR=/tmp/opencv \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies for OpenCV and PaddleOCR
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgthread-2.0-0 \
    libgtk-3-0 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libatlas-base-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy edge service requirements
COPY edge-service/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install PaddleOCR for ANPR
RUN pip install --no-cache-dir paddlepaddle paddleocr

# Copy edge service code
COPY edge_service/ ./edge_service/
COPY scripts/ ./scripts/

# Create directory for models
RUN mkdir -p /app/models

# Copy ONNX models if they exist
COPY yolov8n.onnx /app/models/ 2>/dev/null || true
COPY yolov8n_int8.onnx /app/models/ 2>/dev/null || true

# Set environment variables for edge service
ENV IP_WEBCAM_URL=http://10.115.98.98:8080/video \
    REDIS_HOST=redis \
    REDIS_PORT=6379 \
    USE_THREADED_STREAM=True

# Expose port for health checks (if needed)
EXPOSE 8000

# Default command: run the live IP webcam stream
CMD ["python", "scripts/live_ipwebcam_stream.py"]
