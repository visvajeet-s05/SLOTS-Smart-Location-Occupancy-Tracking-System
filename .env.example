# Database
DATABASE_URL="mysql://root:@localhost:3306/smart_parking"

# Redis
REDIS_URL="redis://localhost:6379"

# Google Maps API Key
# IMPORTANT: To remove the "For development purposes only" watermark:
# 1. Go to https://console.cloud.google.com/google/maps-apis
# 2. Create a project and enable Maps JavaScript API
# 3. Enable billing (includes $200 free monthly credit) - REQUIRED for production use
# 4. Create an API key and restrict it by HTTP referrer for production
# 5. Replace the placeholder below with your actual key
# For development, you can leave this empty to use the built-in simulation mode
# The app will automatically fall back to simulation mode if the key is invalid or billing is not enabled
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Authentication
JWT_SECRET="your_jwt_secret_key"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

# Frontend
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# WebSocket
NEXT_PUBLIC_WEBSOCKET_URL="ws://localhost:4000"

# AI/ML - Camera Service
CAMERA_IP="100.125.245.26:8080"
PYTHON_SERVICE_PORT=5000

# AI/ML
TENSORFLOW_MODEL_PATH="./models"
ENABLE_AI_PRICING=true
AI_RETRAIN_INTERVAL="daily"

# Redis Clustering
REDIS_CLUSTER_ENABLED=true
WEBSOCKET_CLUSTER_ENABLED=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Caching
CACHE_TTL=300
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Production
NODE_ENV=production
LOG_LEVEL=info